# ---------------------------------------------------------------------------
# learning_db - connection settings
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=learning
PGUSER=learning
PGPASSWORD=change_me_in_local_env

# Superuser used only by scripts/reset.sh to drop & recreate the database.
ADMIN_DB=postgres
ADMIN_USER=postgres

# Full URL form consumed by the Node services in learning_apis
DATABASE_URL=postgres://learning:change_me_in_local_env@localhost:5432/learning
