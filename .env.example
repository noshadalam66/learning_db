# ---------------------------------------------------------------------------
# learning_db - connection settings (MySQL 8.0.16+)
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=learning
MYSQL_PASSWORD=change_me_in_local_env

# The platform uses one database per service. This is the prefix-free base name
# used by the shared views and the migration ledger; the seven service
# databases are named identity, catalog, content, progress, assessment, search
# and analytics.
MYSQL_PLATFORM_DB=platform

# Administrative account, used only by scripts/reset.sh to drop and recreate.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Consumed by the Node services in learning_apis.
# The services connect with NO default database and fully-qualify every table,
# because a single service may read a shared view in `platform`.
DATABASE_URL=mysql://learning:change_me_in_local_env@127.0.0.1:3306
